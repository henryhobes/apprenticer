{
  "name": "apprenticer",
  "version": "0.1.0",
  "description": "A voice and board interface for working with AI on anything. A space is a plain folder; Apprenticer serves it on localhost.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "apprenticer": "bin/apprenticer.ts"
  },
  "files": [
    "bin",
    "src",
    "public",
    "examples",
    "template"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "openai": "^7.45.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
