{
  "name": "apprenticer",
  "version": "0.1.0",
  "description": "A voice and board interface for working with AI on anything. A space is a plain folder; Apprenticer serves it on localhost.",
  "type": "module",
  "license": "MIT",
  "author": "Henry Hobin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henryhobes/apprenticer.git"
  },
  "homepage": "https://github.com/henryhobes/apprenticer#readme",
  "bugs": {
    "url": "https://github.com/henryhobes/apprenticer/issues"
  },
  "keywords": [
    "voice",
    "ai",
    "tutor",
    "interview-prep",
    "openai",
    "realtime",
    "claude-code",
    "skill"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "apprenticer": "dist/bin/apprenticer.js"
  },
  "files": [
    "dist",
    "public",
    "examples",
    "skill"
  ],
  "scripts": {
    "start": "node bin/apprenticer.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "site": "node src/site.ts docs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "openai": "^7.45.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
